# Copy to a local ignored .env when integrations are implemented.
# Empty values are intentional: this scaffold has no AWS resources or credentials.
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
S3_UPLOADS_BUCKET=
DYNAMODB_TABLE_NAME=
EVENTBRIDGE_BUS_NAME=
STEP_FUNCTIONS_STATE_MACHINE_ARN=
BEDROCK_MODEL_ID=
SAGEMAKER_ENDPOINT_NAME=
LOG_LEVEL=INFO

# Vite exposes VITE_* values to browsers. Never put secrets here.
# These are placeholders and are not consumed by the current UI.
VITE_AWS_REGION=
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
