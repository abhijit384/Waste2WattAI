# No resources are deployed. Leave values blank until real configuration is available.
# Frontend reads VITE_* values from apps/web/.env.local, not this root file.
AWS_REGION=
W2W_STAGE=dev
W2W_REGION=us-east-1
W2W_FRONTEND_ORIGIN=http://localhost:5173
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
IMAGE_BUCKET=
WASTE_SCANS_TABLE=
EVENTBRIDGE_BUS_NAME=
STEP_FUNCTIONS_STATE_MACHINE_ARN=
BEDROCK_MODEL_ID=
SAGEMAKER_ENDPOINT_NAME=
LOG_LEVEL=INFO

# Vite exposes VITE_* values to browsers. Never put secrets here.
# These four values are required by the frontend; no fake defaults are supplied.
VITE_AWS_REGION=
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
