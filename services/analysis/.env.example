# Copy to .env.local in this directory after rotating any exposed keys.
# Never commit .env.local. This file is read only by local Python runtimes.

AI_INFERENCE_ENABLED=false
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_FREE_ONLY=true
EXTERNAL_AI_ALLOW_PAID=false
EXTERNAL_AI_PAID_USAGE_ALLOWED=false
EXTERNAL_AI_MAX_COST_USD=0
FREE_MODELS_ONLY=true

# Enter newly rotated keys only in services/analysis/.env.local.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Set true only after confirming the corresponding account is non-billable/free.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_BILLING_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_BILLING_ENABLED=false
OPENROUTER_FREE_ENDPOINT_CONFIRMED=false
OPENROUTER_BILLING_ENABLED=false

# Bedrock requires a separate explicit budget approval; default remains disabled.
BEDROCK_INFERENCE_ENABLED=false
BEDROCK_INFERENCE_BUDGET_APPROVED=false
BEDROCK_INFERENCE_MAX_COST_USD=0
